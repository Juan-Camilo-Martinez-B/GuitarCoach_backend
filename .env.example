# Copia a .env en local. No subas secretos.
ENVIRONMENT=local
LOG_LEVEL=INFO
# false deja la API en memoria (pruebas). true persiste en DATABASE_URL.
USE_DATABASE=false
DATABASE_URL=postgresql+asyncpg://guitarcoach:guitarcoach@localhost:54329/guitarcoach
# Genera la tuya: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-public-value-not-for-real-use
# 720 minutos: una tarde de práctica no cierra la sesión a la media hora.
JWT_TTL_MINUTES=720
CORS_ORIGINS=["http://localhost:5173"]
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DAILY_REPORT_LIMIT=5
AUTH_REQUESTS_PER_MINUTE=20
# Vacío: el aviso del trabajo se queda en este proceso.
# Con el contenedor de Redis: redis://localhost:6379/0
REDIS_URL=

# Vercel (proyecto del API). No pegues estos valores aquí; ponlos en el panel.
# ENVIRONMENT=production
# USE_DATABASE=true
# DATABASE_URL=postgresql+asyncpg://postgres.PROYECTO:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# JWT_SECRET= una clave de al menos 32 caracteres, distinta de la de desarrollo
# CORS_ORIGINS=["https://TU-FRONTEND.vercel.app"]
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Vercel define VERCEL=1. No hace falta REDIS_URL: el navegador consulta el trabajo por HTTP.
